# =============================================================================
# SeMF Mobile — Variables de Entorno de Configuración (.env.example)
# =============================================================================
# NOTA: La aplicación funciona 100% de manera autónoma en "Modo Demo" SIN ninguna
# API key configurada. Usa datos históricos reales preagregados y rutas estáticas.
# =============================================================================

# Puerto de escucha del servicio (por defecto 8090)
PORT=8090

# NASA FIRMS API MAP_KEY
# Clave opcional para consultar sobrevuelos en tiempo real (VIIRS/MODIS NRT).
# Si se deja vacía, la app opera con el snapshot satelital local de alta fidelidad.
# Obtener en: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Proveedor de Ruteo Vial de Evacuación
# Opciones disponibles:
#   - 'static_fallback' (por defecto: rutas de contingencia locales precalculadas, sin dependencias externas)
#   - 'openrouteservice' (requiere ORS_API_KEY y calcula evasión de polígonos de fuego en tiempo real)
ROUTING_PROVIDER=static_fallback

# Clave de API de OpenRouteService (ORS)
# Requerida únicamente si ROUTING_PROVIDER=openrouteservice.
# Permite consultar direcciones vehiculares evitando polígonos de focos activos (avoid_polygons).
# Obtener gratuita en: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Bounding Box geográfico de estudio por defecto (minLon,minLat,maxLon,maxLat)
# Por defecto cubre las Sierras de San Luis y Córdoba: -66.0,-33.5,-63.5,-31.0
DEFAULT_BBOX=-66.0,-33.5,-63.5,-31.0
