# =============================================================================
# SeMF 2.0 — Configuración de Variables de Entorno para Despliegue Local Docker
# =============================================================================

# Puerto público exclusivo (NO usar 8080 del proyecto original)
PUBLIC_PORT=8090

# Modo de ejecución
APP_ENV=production

# Base de Datos Espacial PostgreSQL 16 + PostGIS 3.4
POSTGRES_USER=semf_user
POSTGRES_PASSWORD=semf_secure_pass
POSTGRES_DB=semf_geodb

# NASA FIRMS API (Opcional: si está vacío utiliza caché real local en data/raw/)
FIRMS_MAP_KEY=
USE_SYNTHETIC_DATA=false

# Región de Estudio por Defecto (Sierras de Córdoba y San Luis, Argentina)
DEFAULT_BBOX=-66.0,-33.5,-63.5,-31.0

# Parámetros Científicos y de Seguridad Geoespacial
DBSCAN_EPS_KM=2.5
DBSCAN_MIN_SAMPLES=2
DEFAULT_SAFETY_BUFFER_KM=1.2
STALENESS_THRESHOLD_HOURS=12.0

# Motor Vial OSRM (con fallback automático al grafo vial regional embebido)
OSRM_BASE_URL=https://router.project-osrm.org
