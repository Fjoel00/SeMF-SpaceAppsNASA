# =============================================================================
# SeMF 2.0 — Plataforma Geoespacial de Incendios y Evacuación (.env.example)
# =============================================================================
# NOTA: La aplicación funciona 100% de manera autónoma en local SIN ninguna
# API key configurada. Usa datos históricos reales de NASA FIRMS (2000–2026)
# y mapas base públicos sin token (OpenStreetMap y Esri World Imagery).
# =============================================================================

# Puerto público de la aplicación (http://localhost:8090)
PUBLIC_PORT=8090

# Entorno de ejecución
APP_ENV=production

# Base de Datos Geoespacial PostGIS
POSTGRES_USER=semf_user
POSTGRES_PASSWORD=semf_secure_pass
POSTGRES_DB=semf_geodb

# Región BBOX por defecto (Sierras de Córdoba y San Luis)
DEFAULT_BBOX=-66.0,-33.5,-63.5,-31.0

# Parámetros Geoespaciales y Científicos
DBSCAN_EPS_KM=2.5
DBSCAN_MIN_SAMPLES=2
DEFAULT_SAFETY_BUFFER_KM=1.2
STALENESS_THRESHOLD_HOURS=12.0

# Proveedor de Ruteo Abierto (OSRM público / local sin clave)
OSRM_BASE_URL=https://router.project-osrm.org
